+// Non-blocking send for a caller that must never wait: queue the packet if a
+// transmit slot is free, otherwise return 0 at once. usb_rawhid_send(buf, 0)
+// is not that: it spins (calling yield()) until the millisecond tick changes,
+// up to ~1 ms, before it gives up.
+int usb_rawhid_try_send(const void *buffer)
+{
+	if (!usb_configuration) return -1; // usb not enumerated by host
+	transfer_t *xfer = tx_transfer + tx_head;
+	if (usb_transfer_status(xfer) & 0x80) return 0; // all slots in flight
+	uint8_t *txdata = txbuffer + (tx_head * RAWHID_TX_SIZE);
+	memcpy(txdata, buffer, RAWHID_TX_SIZE);
+	arm_dcache_flush_delete(txdata, RAWHID_TX_SIZE );
+	usb_prepare_transfer(xfer, txdata, RAWHID_TX_SIZE, 0);
+	usb_transmit(RAWHID_TX_ENDPOINT, xfer);
+	if (++tx_head >= TX_NUM) tx_head = 0;
+	return RAWHID_TX_SIZE;
+}
+
 int usb_rawhid_available(void)
 {
 	if (!usb_configuration) return 0;
