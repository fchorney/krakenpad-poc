+// Non-blocking send for callers in interrupt context: queue the report if a
+// transmit slot is free, otherwise return -1 at once so the caller retries.
+// Callers must not preempt each other (run them at one NVIC priority).
+int usb_joystick_try_send(const void *report)
+{
+	if (!usb_configuration) return -1;
+	uint32_t head = tx_head;
+	transfer_t *xfer = tx_transfer + head;
+	if (usb_transfer_status(xfer) & 0x80) return -1;
+	delayNanoseconds(30); // as usb_joystick_send()
+	uint8_t *buffer = txbuffer + head * TX_BUFSIZE;
+	memcpy(buffer, report, JOYSTICK_SIZE);
+	usb_prepare_transfer(xfer, buffer, JOYSTICK_SIZE, 0);
+	arm_dcache_flush_delete(buffer, TX_BUFSIZE);
+	usb_transmit(JOYSTICK_ENDPOINT, xfer);
+	if (++head >= TX_NUM) head = 0;
+	tx_head = head;
+	return 0;
+}
+
 #endif // JOYSTICK_INTERFACE
